# Environment
ENV_MODE=development
PORT=8080

# Database
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=postgres
DB_DBNAME=auth_db
DB_PORT=5432

# JWT Configuration
JWT_SECRET=your-secret-key-min-32-characters-long
JWT_ISSUER=svc-auth
JWT_EXPIRE=3600
JWT_ACCESS_TOKEN_TTL=1h
JWT_REFRESH_TOKEN_TTL=720h

# OAuth Encryption Key (MUST be 32 bytes for AES-256)
OAUTH_ENCRYPTION_KEY=your-32-byte-encryption-key-here!

# OAuth Redirect URL (base URL for all OAuth callbacks)
OAUTH_REDIRECT_URL=http://localhost:8080

# Google OAuth
OAUTH_GOOGLE_ENABLED=true
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URL=http://localhost:8000/v1/auth/oauth/google/callback
OAUTH_GOOGLE_SCOPES=openid profile email

# Facebook OAuth
OAUTH_FACEBOOK_ENABLED=false
OAUTH_FACEBOOK_CLIENT_ID=
OAUTH_FACEBOOK_CLIENT_SECRET=
OAUTH_FACEBOOK_REDIRECT_URL=http://localhost:8000/v1/auth/oauth/facebook/callback
OAUTH_FACEBOOK_SCOPES=email public_profile

# GitHub OAuth
OAUTH_GITHUB_ENABLED=false
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GITHUB_REDIRECT_URL=http://localhost:8000/v1/auth/oauth/github/callback
OAUTH_GITHUB_SCOPES=read:user user:email
